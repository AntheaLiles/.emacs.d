{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(reuse lint)",
      "Bash(reuse lint:*)",
      "Bash(reuse spdx:*)",
      "Bash(emacs -Q --batch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./history)",
      "Read(./custom.el)",
      "Read(./places)",
      "Read(./recentf)",
      "Read(./tramp)",
      "Read(./elpaca/**)",
      "Read(./eln-cache/**)"
    ]
  }
}
